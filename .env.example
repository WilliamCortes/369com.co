# ==============================================================================
# 369COM.CO - Environment Configuration & Production Activation Schema
# ==============================================================================
# For local development: copy this file to .env.local
# In production (Vercel): configure these variables in Project Settings -> Environment Variables
# ==============================================================================

# --- Application Configuration ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=https://369com.co

# --- Monetization & Stripe Sandbox Simulation ---
# Set to 'true' to allow deterministic end-to-end checkout & webhook testing without live Stripe API keys.
# Set to 'false' in production once live keys are configured.
MOCK_PAYMENTS=true

# Safety guard: Set to 'true' ONLY if running simulated payments in a staging/preview production deployment.
# When 'false' (default), attempting mock checkout in NODE_ENV=production returns HTTP 503.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

# --- Payment Provider Selection ('polar' or 'stripe') ---
# Polar.sh is recommended for Merchant-of-Record global payouts including Colombia.
PAYMENT_PROVIDER=polar
POLAR_ENVIRONMENT=production
POLAR_ACCESS_TOKEN=polar_oat_placeholder_token_for_testing
POLAR_WEBHOOK_SECRET=whsec_placeholder_secret_for_testing
POLAR_PRODUCT_ID_STARTER=
POLAR_PRODUCT_ID_BLUEPRINT=
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_MASTER=

# --- Stripe Live / Test API Credentials (Optional Alternative) ---
# Required in production when PAYMENT_PROVIDER=stripe and MOCK_PAYMENTS=false.
# Secret key MUST begin with 'sk_live_' (or 'sk_test_' in test mode).
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_testing

# Publishable key MUST begin with 'pk_live_' (or 'pk_test_' in test mode).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_testing

# Webhook signing secret from the Stripe Dashboard (Webhooks -> Endpoint -> Signing secret).
# Begins with 'whsec_'.
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_for_testing

# --- Digital Rights Management (DRM) & Asset Download Cryptography ---
# High-entropy cryptographic HMAC-SHA256 signing secret for digital asset download tokens.
# MANDATORY: MUST be at least 32 characters long.
DOWNLOAD_SIGNING_SECRET=369_universal_manifestation_download_secret_key_32_chars_min

# Backward-compatibility alias for download signing secret
FULFILLMENT_JWT_SECRET=369_universal_manifestation_download_secret_key_32_chars_min

# --- Product Catalog Price Overrides (Integer Cents) ---
# Override canonical product prices in cents without redeploying code.
PRICE_STARTER_CENTS=499
PRICE_PRO_CENTS=999
PRICE_MASTER_CENTS=1999
